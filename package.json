{
  "name": "online-learning-api",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test test/api/*.test.js",
    "api:smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke-api.ps1",
    "api:test:live": "powershell -ExecutionPolicy Bypass -File scripts/live-api-full-test.ps1",
    "api:read": "node scripts/live-read-probe.cjs",
    "api:write": "node scripts/live-write-e2e.cjs",
    "api:sweep": "node scripts/live-write-sweep.cjs",
    "api:cleanup": "node scripts/live-cleanup.cjs",
    "docker:doctor": "powershell -ExecutionPolicy Bypass -File scripts/docker-doctor.ps1",
    "docker:up": "powershell -ExecutionPolicy Bypass -File scripts/docker-up.ps1",
    "docker:down": "powershell -ExecutionPolicy Bypass -File scripts/docker-down.ps1",
    "docker:logs": "docker compose logs -f api",
    "db:init:pg": "node scripts/init-postgres.js",
    "db:seed:pg": "node scripts/seed-postgres.js",
    "db:verify:pg": "node scripts/verify-postgres.js",
    "db:migrate:sqlserver-to-pg": "node scripts/migrate-sqlserver-to-postgres.js",
    "api:authz": "node scripts/live-authz-probe.cjs",
    "api:coverage": "node scripts/live-full-coverage.cjs",
    "api:leftover": "node scripts/live-leftover-check.cjs",
    "db:migrate:auth": "node scripts/migrate-auth.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Online Learning Platform API",
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.2.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.95.1",
    "pg": "^8.14.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
