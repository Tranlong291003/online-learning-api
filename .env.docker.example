# Copy values into `.env` or your shell before running docker compose if needed.
# The compose file already supplies local PostgreSQL defaults.

AI_BASE_URL=http://host.docker.internal:20128/v1
AI_API_KEY=sk-your-ai-gateway-key
AI_MODEL=ag/gemini-3.8-flash
YOUTUBE_API_KEY=your-youtube-api-key

# Pick one Firebase credential style for production/local auth endpoints:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_PATH=
