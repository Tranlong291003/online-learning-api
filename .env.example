# =============================================================
# Supabase (copy từ Project Settings → API)
# =============================================================
# Project URL — dạng: https://<project-ref>.supabase.co
SUPABASE_URL=

# service_role key (SECRET — KHÔNG commit, KHÔNG share)
# Có full quyền bypass RLS — chỉ dùng backend
SUPABASE_SERVICE_KEY=

# anon public key (an toàn public)
# Dùng cho client nếu cần RLS-bound requests
SUPABASE_ANON_KEY=

# =============================================================
# Server
# =============================================================
PORT=3000
NODE_ENV=development

# =============================================================
# Supabase Storage bucket cho uploads (avatar, course thumb, lesson video, ...)
# =============================================================
SUPABASE_STORAGE_BUCKET=uploads
