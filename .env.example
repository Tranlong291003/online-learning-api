# PostgreSQL Database (Supabase / Neon / Render / Railway)
# Prefer DATABASE_URL on deploy platforms when available.
DATABASE_URL=postgresql://postgres.your_project_ref:your_postgres_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_postgres_password
DB_SSL=true

# SQL Server source (only for one-time migration script)
SOURCE_DB_SERVER=localhost
SOURCE_DB_PORT=1433
SOURCE_DB_DATABASE=OnlineLearningDB
SOURCE_DB_USER=your_sqlserver_user
SOURCE_DB_PASSWORD=your_sqlserver_password
SOURCE_DB_ENCRYPT=false
SOURCE_DB_TRUST_CERT=true
MIGRATION_BATCH_SIZE=500

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Security
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# --- Xác thực (xem src/config/auth.config.js) ---
# API tự quản lý tài khoản (email/password + bcrypt); KHÔNG còn dùng Firebase Auth.
# Access token ngắn hạn vì JWT không thu hồi được giữa chừng.
ACCESS_TOKEN_TTL=15m
# Refresh token lưu trong bảng refresh_tokens nên thu hồi được.
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS_REMEMBER=90
# Số vòng bcrypt. 12 là mặc định; giảm xuống 10 nếu CPU server yếu.
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=6
# Chống dò mật khẩu: khoá tạm sau N lần sai liên tiếp.
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
# Thời hạn token đặt lại mật khẩu.
RESET_TOKEN_TTL_MINUTES=15
# Chốt cứng issuer/audience khi ký và verify access token.
JWT_ISSUER=online-learning-api
JWT_AUDIENCE=online-learning-client

# Mật khẩu cho các tài khoản demo của `npm run db:seed:pg`.
SEED_DEMO_PASSWORD=Demo@123456

# Dev only - bypass JWT bằng header "x-dev-api-key".
# Chỉ hoạt động khi NODE_ENV khác "production". Để trống ở production.
DEV_API_KEY=
DEV_API_KEY_UID=dev-admin
DEV_API_KEY_ROLE=admin

# --- Firebase (CHỈ còn dùng để gửi push notification FCM) ---
# Không còn liên quan tới đăng nhập. Có thể để trống nếu không gửi thông báo đẩy.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# APIs
OPENAI_API_KEY=sk-your-openai-key
YOUTUBE_API_KEY=your-youtube-api-key
